{
  "name": "Lesson",
  "type": "object",
  "properties": {
    "course_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "order": {
      "type": "number"
    },
    "xp_reward": {
      "type": "number"
    },
    "summary": {
      "type": "string"
    },
    "content": {
      "type": "string"
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "prompt": {
            "type": "string"
          },
          "options": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "answer": {
            "type": "number"
          },
          "explanation": {
            "type": "string"
          }
        },
        "required": [
          "prompt",
          "options",
          "answer"
        ]
      }
    }
  },
  "required": [
    "course_id",
    "title"
  ]
}
